{
  "name": "react-schemaorg",
  "version": "2.0.1",
  "displayName": "React: Schema.org",
  "description": "Typed Schema.org JSON-LD in React",
  "authors": [
    "Eyas Sharaiha <eyas@google.com> (https://eyas.sh/)"
  ],
  "maintainers": [
    "Eyas Sharaiha <npm@eyas.sh> (https://eyas.sh/)"
  ],
  "types": "./dist/src/index.d.ts",
  "main": "./dist/src/index.js",
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-test-renderer": "^19.2.4",
    "schema-dts": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=16.3.0",
    "schema-dts": ">=0.7.4",
    "typescript": ">=3.1.6"
  },
  "keywords": [
    "react",
    "jsonld",
    "JSON-LD",
    "typescript",
    "schema.org",
    "Semantic Web",
    "semantic-web",
    "Linked Data",
    "linked-data",
    "react-helmet",
    "helmet",
    "script",
    "seo"
  ],
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "lint": "prettier --check \"src/**/*\" \"test/**/*\" \"type-test/**/*\"",
    "fix": "prettier --write \"src/**/*\" \"test/**/*\" \"type-test/**/*\"",
    "test": "npm run lint && tsc --build type-test/ && jest",
    "build": "tsc --build .",
    "prepare": "npm run build",
    "release:exit-gate": "npx --yes google-artifactregistry-auth --repo-config=.npmrc --credential-config=$HOME/.npmrc && npm publish && VERSION=$(node -p \"require('./package.json').version\") && printf '{\"publish_all\":false,\"publishing_groups\":[{\"packages\":[{\"name\":\"react-schemaorg\",\"version\":\"%s\"}]}]}\\n' \"$VERSION\" > /tmp/react-schemaorg-manifest-$VERSION.json && gcloud storage cp /tmp/react-schemaorg-manifest-$VERSION.json gs://oss-exit-gate-prod-projects-bucket/react-schemaorg/npm/manifests/manifest-$VERSION-$(date +%s).json"
  },
  "homepage": "https://github.com/google/react-schemaorg#readme",
  "bugs": "https://github.com/google/react-schemaorg/issues",
  "repository": "github:google/react-schemaorg",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://us-npm.pkg.dev/oss-exit-gate-prod/react-schemaorg--npm/"
  }
}
